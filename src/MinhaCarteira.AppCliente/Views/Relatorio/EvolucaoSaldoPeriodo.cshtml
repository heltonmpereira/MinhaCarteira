@using MinhaCarteira.AppCliente.ViewModel
@using MinhaCarteira.AppCliente.ViewModel.Relatorio
@using MinhaCarteira.AppCliente.ViewModel.Relatorio.EvolucaoSaldoPeriodo
@using MinhaCarteira.AppCliente.ViewModel.Relatorio.GastosPorCategoriaPeriodo
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@model EvolucaoSaldoPeriodoRelatorioViewModel

@{
}

@section Css
{
    <link asp-append-version="true" rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.css">
    <link asp-append-version="true" rel="stylesheet" href="~/css/evolucao-saldo-periodo.css" nws-csp-add-nonce="true">
}

@section Scripts {
    @{
        <script nws-csp-add-nonce="true" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script asp-append-version="true" nws-csp-add-nonce="true" src="~/lib/printthis/lib/jquery.printthis.js"></script>
        <script asp-append-version="true" nws-csp-add-nonce="true" src="~/lib/bootstrap-table/bootstrap-table.js"></script>
        <script asp-append-version="true" nws-csp-add-nonce="true" src="~/js/views/evolucao-saldo-periodo.js"></script>
        <script nws-csp-add-nonce="true" type="text/javascript">
            const relatorioData = @Html.Raw(JsonConvert.SerializeObject(Model.EvolucaoSaldoPeriodo));
            window.relatorioData = relatorioData;
            const gastosPorCategoriaData = @Html.Raw(JsonConvert.SerializeObject(Model.GastosPorCategoriaPeriodo));
            const dataInicialFormatada = @Html.Raw(JsonConvert.SerializeObject(Model.DataInicial.ToString("dd/MM/yyyy")));
            const dataFinalFormatada = @Html.Raw(JsonConvert.SerializeObject(Model.DataFinal.ToString("dd/MM/yyyy")));
            const evolucaoSaldoItensRaw = @Html.Raw(JsonConvert.SerializeObject(Model.EvolucaoSaldoPeriodo.Itens));
            const gastosPorCategoriaItensRaw = @Html.Raw(JsonConvert.SerializeObject(Model.GastosPorCategoriaPeriodo?.Itens ?? new List<GastosPorCategoriaPeriodoItemViewModel>()));

            inicializarEvolucaoSaldoPeriodo({
                relatorioData: relatorioData,
                gastosPorCategoriaData: gastosPorCategoriaData,
                evolucaoSaldoItensRaw: evolucaoSaldoItensRaw,
                gastosPorCategoriaItensRaw: gastosPorCategoriaItensRaw,
                dataInicialFormatada: dataInicialFormatada,
                dataFinalFormatada: dataFinalFormatada
            });
        </script>
    }
}

<nav class="navbar navbar-expand-sm navbar-@ViewBag.Theme sticky-top px-2 m-0">
    <h4 class="px-3 mb-2 mb-sm-0">Evolução do Saldo</h4>
    <form asp-action="EvolucaoSaldoPeriodo" method="get" class="col-12 col-sm-10">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-sm-3">
                <label asp-for="DataInicial" class="form-label">Data Inicial</label>
                <input asp-for="DataInicial" type="date" class="form-control">
            </div>
            <div class="col-6 col-sm-3">
                <label asp-for="DataFinal" class="form-label">Data Final</label>
                <input asp-for="DataFinal" type="date" class="form-control">
            </div>
            <div class="col-12 col-sm-3">
                <label asp-for="ContaBancariaId" class="form-label">Conta Bancária</label>
                <select asp-for="ContaBancariaId" asp-items="new SelectList(Model.ContasBancarias, nameof(ContaBancariaViewModel.Id), nameof(ContaBancariaViewModel.Nome))" class="form-select">
                    <option value="">Todas as Contas</option>
                </select>
            </div>
            <div class="col-12 col-sm-3 pt-0 pt-sm-4">
                <input type="submit" value="Processar" class="btn @(ViewBag.ClasseBotao)primary w-100" />
            </div>
        </div>
    </form>
</nav>

<div id="divConteudoImpressao" class="container-fluid p-3">
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="grafico-tab" data-bs-toggle="tab" data-bs-target="#grafico-tab-pane" type="button" role="tab" aria-controls="grafico-tab-pane" aria-selected="true">Gráfico</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tabela-tab" data-bs-toggle="tab" data-bs-target="#tabela-tab-pane" type="button" role="tab" aria-controls="tabela-tab-pane" aria-selected="false">Tabela</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="gastos-categoria-tab" data-bs-toggle="tab" data-bs-target="#gastos-categoria-tab-pane" type="button" role="tab" aria-controls="gastos-categoria-tab-pane" aria-selected="false">Gastos por Categoria</button>
                            </li>
                        </ul>

                        @if (Model.EvolucaoSaldoPeriodo != null && Model.EvolucaoSaldoPeriodo.Itens.Count > 0)
                        {
                            <div class="btn-group" role="group">
                                <button type="button" id="btnImprimir" class="btn @(ViewBag.ClasseBotao)secondary">
                                    <i class="fas fa-print me-2"></i>Imprimir
                                </button>
                                <button type="button" id="btnExportarCSV" class="btn @(ViewBag.ClasseBotao)info">
                                    <i class="fas fa-file-csv me-2"></i>CSV
                                </button>
                                <button type="button" id="btnExportarHTML" class="btn @(ViewBag.ClasseBotao)success">
                                    <i class="fas fa-file-code me-2"></i>HTML
                                </button>
                            </div>
                        }
                    </div>

                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active pt-3" id="grafico-tab-pane" role="tabpanel" aria-labelledby="grafico-tab">
                            <h5 class="card-title">Evolução do Saldo no Período</h5>
                            <div class="chart-container">
                                <canvas id="graficoEvolucaoSaldoPeriodo"></canvas>
                            </div>
                        </div>

                        <div class="tab-pane fade pt-3" id="tabela-tab-pane" role="tabpanel" aria-labelledby="tabela-tab">
                            <h5 class="card-title">Saldos Diários</h5>
                            <div class="table-responsive">
                                <table id="tableEvolucaoSaldo" class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Data</th>
                                            <th>Saldo Inicial</th>
                                            <th>Movimentos Realizados</th>
                                            <th>Movimentos Planejados</th>
                                            <th>Saldo Final</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.EvolucaoSaldoPeriodo != null && Model.EvolucaoSaldoPeriodo.Itens.Count > 0)
                                        {
                                            @foreach (var item in Model.EvolucaoSaldoPeriodo.Itens)
                                            {
                                                <tr>
                                                    <td>@item.Data.ToString("dd/MM/yyyy")</td>
                                                    <td>@item.SaldoInicial.ToString("C2")</td>
                                                    <td class="@(item.MovimentosRealizados >= 0 ? "text-success" : "text-danger")">@item.MovimentosRealizados.ToString("C2")</td>
                                                    <td class="@(item.MovimentosPlanejados >= 0 ? "text-success" : "text-danger")">@item.MovimentosPlanejados.ToString("C2")</td>
                                                    <td>@item.SaldoFinal.ToString("C2")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="tab-pane fade pt-3" id="gastos-categoria-tab-pane" role="tabpanel" aria-labelledby="gastos-categoria-tab">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="card-title mb-0">Gastos por Categoria no Período</h5>
                                @if (Model.GastosPorCategoriaPeriodo != null && Model.GastosPorCategoriaPeriodo.Itens.Count > 0)
                                {
                                    <button type="button" id="btnExportarGastosCSV" class="btn @(ViewBag.ClasseBotao)info btn-sm">
                                        <i class="fas fa-file-csv me-2"></i>Exportar CSV
                                    </button>
                                }
                            </div>

                            @if (Model.GastosPorCategoriaPeriodo != null && Model.GastosPorCategoriaPeriodo.Itens.Count > 0)
                            {
                                <div class="alert alert-danger mb-4" role="alert">
                                    <strong>Total de Gastos no Período:</strong> @Model.GastosPorCategoriaPeriodo.TotalGastos.ToString("C2")
                                </div>

                                <div class="gastos-categoria-wrapper">
                                    <div class="gastos-categoria-chart">
                                        <div class="chart-pie-container">
                                            <canvas id="graficoGastosPorCategoria"></canvas>
                                        </div>
                                    </div>

                                    <div class="gastos-categoria-lista">
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Categoria</th>
                                                        <th class="text-end">Valor</th>
                                                        <th class="text-center">Qtd.</th>
                                                        <th class="text-end th-percentual">%</th>
                                                        <th class="th-progress"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.GastosPorCategoriaPeriodo.Itens)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(item.CategoriaPaiNome))
                                                                {
                                                                    <small class="text-muted">@item.CategoriaPaiNome</small><br />
                                                                    <strong>@item.CategoriaNome</strong>
                                                                }
                                                                else
                                                                {
                                                                    <strong>@item.CategoriaNome</strong>
                                                                }
                                                            </td>
                                                            <td class="text-end text-danger">@item.Valor.ToString("C2")</td>
                                                            <td class="text-center">@item.QuantidadeMovimentos</td>
                                                            <td class="text-end">@item.Percentual.ToString("F2")%</td>
                                                            <td>
                                                                <div class="progress progress-categoria">
                                                                    <div class="progress-bar bg-danger progress-bar-width" role="progressbar"
                                                                     data-width="@item.Percentual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                                     aria-valuenow="@item.Percentual"
                                                                         aria-valuemin="0"
                                                                         aria-valuemax="100"></div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="table-secondary">
                                                        <th><strong>Total</strong></th>
                                                        <th class="text-end text-danger"><strong>@Model.GastosPorCategoriaPeriodo.TotalGastos.ToString("C2")</strong></th>
                                                        <th class="text-center"><strong>@Model.GastosPorCategoriaPeriodo.Itens.Sum(i => i.QuantidadeMovimentos)</strong></th>
                                                        <th class="text-end"><strong>100%</strong></th>
                                                        <th></th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info" role="alert">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Nenhum gasto foi encontrado no período selecionado.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.EvolucaoSaldoPeriodo != null)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Resumo do Período</h5>
                        <p><strong>Saldo Inicial Total:</strong> @Model.EvolucaoSaldoPeriodo.SaldoInicialTotal.ToString("C2")</p>
                        @if (Model.GastosPorCategoriaPeriodo != null && Model.GastosPorCategoriaPeriodo.TotalGastos > 0)
                        {
                            <p><strong>Total de Gastos:</strong> <span class="@ViewBag.ColorTextError">@Model.GastosPorCategoriaPeriodo.TotalGastos.ToString("C2")</span></p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
