@using MinhaCarteira.AppCliente.ViewModel
@using MinhaCarteira.AppCliente.ViewModel.Base
@model MinhaCarteira.AppCliente.ViewModel.AgendamentoParcelaViewModel

@{
    ViewData["Title"] = "Agendamento";
    ViewData["Icone"] = "<i class='fa fa-calendar-day fa-lg'></i>";
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
            <script src="~/js/autoComplete/configurarAutoComplete.js" asp-append-version="true"></script>
            <script src="~/js/autoComplete/cadastroAutoComplete.js" asp-append-version="true"></script>
            <script src="~/js/views/agendamentoView.js" asp-append-version="true"></script>
            <script type="text/javascript" nws-csp-add-nonce="true">
                @{
                    var opcao = "tipoParcela" + Model.Agendamento.TipoParcelas;
                }

                    let opcao = "@opcao";
                definirTipoParcelas(opcao);
            </script>
        }
    }

    var isMobile = ((BrowserViewModel)ViewBag.BrowserInfo).IsMobile;
    var templateMovimentoBancario = isMobile
        ? "MovimentoBancarioTabelaExtratoMovel"
        : "MovimentoBancarioTabelaExtrato";
}

<form asp-action="AlterarParcela" method="post" class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Alterar</h1>
    <hr />

    <div class="row mb-3 bg-body-secondary p-2 mx-auto">
        <div class="col-sm-4">
            <div class="form-check form-switch ms-3">
                <input class="form-check-input" asp-for="AlterarAPenasEstaParcela">
                <label class="form-check-label" asp-for="AlterarAPenasEstaParcela"></label>
            </div>
        </div>

        <div class="col-sm-8">
            <div class="form-check form-switch ms-3">
                <input class="form-check-input" asp-for="DespesaOpcional">
                <label class="form-check-label" asp-for="DespesaOpcional"></label>
            </div>
        </div>
    </div>

    @Html.EditorForModel()
</form>

                
@if (Model.ConciliacaoBancariaAgendamentoParcela != null)
{
    var movimentos = Model.ConciliacaoBancariaAgendamentoParcela
        .ConciliacaoBancaria
        .Movimentos
        .Select(s => s.MovimentoBancario)
        .ToList();

    var pagina = new X.PagedList.StaticPagedList<MovimentoBancarioViewModel>(
        movimentos, 1, movimentos.Count, movimentos.Count);

    var lista = new ListaMovimentoBancarioViewModel
    {
        Itens = pagina
    };

    <div class="row bg-body-secondary p-2 col-sm-11 px-sm-3 mx-auto ">
        <span class="form-label col-12 text-success">
            <i class="fa fa-handshake"></i>
            Conciliado em @Model.ConciliacaoBancariaAgendamentoParcela.ConciliacaoBancaria.DataCadastro.ToString("dd/MM/yyyy HH:mm")
        </span>

    </div>

    @Html.DisplayFor(model => lista, templateMovimentoBancario)
}
