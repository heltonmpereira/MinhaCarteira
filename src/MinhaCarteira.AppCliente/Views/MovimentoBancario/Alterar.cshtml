@using MinhaCarteira.AppCliente.ViewModel
@using MinhaCarteira.AppCliente.ViewModel.Base
@model MinhaCarteira.AppCliente.ViewModel.MovimentoBancarioViewModel

@{
    var arqCount = Model.MovimentoBancarioArquivos?.Count ?? 0;
    ViewData["Title"] = "Movimento Bancário";
    ViewData["Icone"] = "<i class='fa fa-money-bill-transfer fa-lg d-inline'></i>";
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
            <script src="~/js/autoComplete/configurarAutoComplete.js" asp-append-version="true"></script>
            <script src="~/js/autoComplete/cadastroAutoComplete.js" asp-append-version="true"></script>
            <script src="~/js/views/selecionarArquivos.js" asp-append-version="true" nws-csp-add-nonce="true"></script>
            <script asp-append-version="true" nws-csp-add-nonce="true">
                document.addEventListener('DOMContentLoaded', function () {
                    inicializarContador(@arqCount);
                });
            </script>
        }
    }

    var isMobile = ((BrowserViewModel)ViewBag.BrowserInfo).IsMobile;
    var templateAgendamento = isMobile
        ? "AgendamentoTabelaExtratoMovel"
        : "AgendamentoTabelaExtrato";
}

<form asp-action="Alterar" method="post" enctype="multipart/form-data" class="col-11 px-sm-3 px-md-0 pt-4 mx-auto">
    <h1>Alterar</h1>
    <hr />

    @Html.EditorForModel()
</form>


@if (Model.TransferenciaBancaria != null)
{
    <div class="row bg-body-secondary mb-3 px-0 col-sm-11 mx-auto">
        <div class="col-8">
            <label class="form-label col-12 text-success px-0">
                <i class="fa fa-money-bill-transfer"></i>
                Transferência bancária
            </label>

            @if (Model.TransferenciaBancaria.Origem.ContaBancariaId == Model.ContaBancariaId)
            {
                <label class="form-label @ViewBag.ColorTextError">Conta de Destino: </label>
                <span class="d-inline-block">@Model.TransferenciaBancaria.Destino.ContaBancaria.Nome</span>
            }
            else
            {
                <label class="form-label text-primary">Conta de Origem: </label>
                <span class="d-inline-block">@Model.TransferenciaBancaria.Origem.ContaBancaria.Nome</span>
            }
        </div>

        <div class="col-4 align-content-center text-end p-3">
            <a id="btnRemover" class="btn @(ViewBag.ClasseBotao)danger d-inline-block py-3 px-2" asp-action="RemoverTransferenciaBancaria">
                <i class="fa fa-trash"></i>
                <span class="d-md-inline">Remover</span>
            </a>
        </div>
    </div>
}

@if (Model.ConciliacaoBancariaMovimento != null)
{
    var parcelas = Model.ConciliacaoBancariaMovimento
        .ConciliacaoBancaria
        .AgendamentoParcelas
        .Select(s => s.AgendamentoParcela)
        .ToList();

    var lista = new ListaBaseViewModel<AgendamentoParcelaViewModel>(parcelas, null, parcelas.Count);

    <div class="row bg-body-secondary col-sm-11 px-sm-3 mx-auto">
        <span class="form-label col-12 text-success">
            <i class="fa fa-handshake"></i>
            Conciliado em @Model.ConciliacaoBancariaMovimento.ConciliacaoBancaria.DataCadastro.ToString("dd/MM/yyyy HH:mm")
        </span>

    </div>

    @Html.DisplayFor(model => lista, templateAgendamento)
}
