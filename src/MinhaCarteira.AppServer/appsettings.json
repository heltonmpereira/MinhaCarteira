{
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.Hosting.Lifetime": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "MinhaCarteira.API"
    }
  },

  // SEGREDOS: use User Secrets (UserSecretsId já definido no .csproj) ou variáveis de ambiente.
  //   dotnet user-secrets set "Jwt:Segredo" "..."
  //   Produção: Jwt__Segredo
  "Jwt": {
    // Não versionar. Local: dotnet user-secrets set "Jwt:Segredo" "..."
    // Produção: Jwt__Segredo
    "Segredo": ""
  },

  // dotnet user-secrets set "ConnectionStrings:Default" "..."
  // Produção: ConnectionStrings__Default
  "ConnectionStrings": {
    "Default": ""
  },

  // dotnet user-secrets set "Repositorio:Chave" "..."
  // dotnet user-secrets set "Repositorio:IV" "..."
  // Produção: Repositorio__Chave, Repositorio__IV
  "Repositorio": {
    "CaminhoImagens": "C:\\Web\\Repositorio\\MinhaCarteira",
    "Chave": "",
    "IV": ""
  },

  "AllowedHosts": "*",

  "CorsOrigins": "https://localhost, http://localhost:5173, https://localhost:44352",

  "UrlBase": "",
  "SwaggerEndpoint": "/swagger/v1/swagger.json",

  "DefinicaoArquivos": {
    "UploadTamanhoMaximo": "524288",
    "UploadExtensaoPermitida": ".jpg, .jpeg, .png",
    "UploadRepositorioImagens": "wwwroot\\images"
  }
}
